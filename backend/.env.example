# Fliki 后端 .env 模板 (复制此文件为 .env 后填入真实 key)
# 警告: 不要把含真实 key 的 .env 提交到 Git; 不要贴聊天/截图.

# ===== Stock 视频 / 图片 (Pexels / Pixabay 免费, 注册即可) =====
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ===== Stock 音效 (Freesound) =====
FREESOUND_API_KEY=

# ===== Provider 加密 (任意 32+ 字符, 用于持久化 key 加密; 改了不影响存量数据解密) =====
PROVIDER_SECRET_KEY=

# ===== LLM (可选, 文本生成 / 自动剪辑, 不填走 Mock) =====
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=


# ===== TTS (可选, 真实声音 / 声音克隆) =====
# MiniMax 云端 API (P7-1): speech-02-turbo / speech-2.8-hd 等 8 模型 + 40+ 语言 + 声音克隆
MINIMAX_API_KEY=
# MiniMax 自定义配置 (可选)
# FLIKI_MINIMAX_BASE_URL=https://api.minimaxi.com
# FLIKI_MINIMAX_MODEL=speech-02-turbo
# GPT-SoVITS 本地服务 (P5D-3, 需另机 GPU)
# GPT_SOVITS_URL=http://127.0.0.1:9880
# ===== TTS (可选, 真实声音克隆) =====
# GPT_SOVITS_URL=http://127.0.0.1:9880

# ===== Avatar (可选, 真实数字人) =====
# WAV2LIP_MODEL_PATH=

# ===== MiniMax Music (云端, music-3.0 AI 生成 BGM, 带 lyrics) =====
# (与 TTS 共用 MINIMAX_API_KEY)
# FLIKI_MINIMAX_MUSIC_MODEL=music-3.0

# ===== Pollinations / 其他媒体生成 (可选) =====
# POLLINATIONS_API_KEY=
# FAL_API_KEY=
# PIXVERSE_API_KEY=


# ===== OmniVoice-Studio (本地 TTS, AGPL-3.0, 仅 HTTP 调用不污染许可证) =====
# 部署: docker run -d --name omnivoice -p 127.0.0.1:3900:3900 ^
#         -e HF_ENDPOINT=https://hf-mirror.com -e HF_HUB_DISABLE_XET=1 ^
#         -e OMNIVOICE_TTS_BACKEND=kittentts ^
#         -v D:/workspace/docker-volumes/omnivoice-data:/app/omnivoice_data ^
#         ghcr.io/debpalash/omnivoice-studio:latest
# voice 协议: omnivoice:<voice_id> 强制走 OmniVoice
OMNIVOICE_BASE_URL=http://127.0.0.1:3900
# CPU-only 机器推荐 kittentts; GPU/大内存可保留 tts-1 使用当前 active engine
OMNIVOICE_MODEL=kittentts
# OMNIVOICE_API_KEY=  (默认无鉴权; 反代场景填 Bearer token)


# ===== LLM (高光评分 / 自动剪辑文案) =====
# 复用 MiniMax 也可走 OpenAI 兼容; 不填走 Mock (本地规则评分)
HIGHLIGHT_LLM_PROVIDER=mock
HIGHLIGHT_LLM_BASE_URL=
HIGHLIGHT_LLM_API_KEY=
HIGHLIGHT_LLM_MODEL=

# ===== rev34 P1: 补全的 runtime 配置 =====
# 启动 host/port (config.py 默认 127.0.0.1:5181)
# FLIKI_HOST=127.0.0.1
# FLIKI_PORT=5181
# 渲染超时 (秒, 默认 3600)
# RENDER_TIMEOUT_SECONDS=3600
# faster-whisper 模型 (autoedit.py 默认 base, 性能/精度: tiny < base < small < medium < large-v3)
FLIKI_WHISPER_MODEL=base
# OpenAI 兼容转写 API (填了走 API, 不填走本地 faster-whisper)
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# WHISPER_BASE_URL=
# WHISPER_API_KEY=
# 磁盘路径 (env_check 报告磁盘剩余)
# FLIKI_DISK_PATH=D:/workspace
# wav2lip 模型路径
# FLIKI_WAV2LIP_MODEL=data/models/wav2lip/wav2lip.onnx
# MiniMax 多模态模型 (image / video)
FLIKI_MINIMAX_IMAGE_MODEL=image-01
FLIKI_MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-2.3
# GPT-SoVITS URL (env_check 读 FLIKI_GPT_SOVITS_URL)
# FLIKI_GPT_SOVITS_URL=http://127.0.0.1:9880
# 启动环境 (dev 默认; prod 强制要求 JWT_SECRET 强随机)
# FLIKI_ENV=dev
