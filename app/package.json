{
  "name": "fliki-draft-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "visual-diff": "python ../tests/e2e/visual_diff.py --threshold 0.001",
    "visual-diff:update": "python ../tests/e2e/visual_diff.py --update-baselines"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "^25.0.0",
    "vitest": "^1.6.0"
  }
}
